# Flask
SECRET_KEY=supersecretkey
# Debug mode (debugger interativo do Werkzeug) — deixe desligado em produção
FLASK_DEBUG=false

# Web3 provider — testnet Sepolia
# Padrão (sem chave): https://ethereum-sepolia-rpc.publicnode.com
# Para usar Infura/Alchemy, crie um projeto e cole a URL abaixo:
# WEB3_PROVIDER_URL=https://sepolia.infura.io/v3/SEU_PROJECT_ID
# WEB3_PROVIDER_URL=https://eth-sepolia.g.alchemy.com/v2/SUA_API_KEY
WEB3_PROVIDER_URL=https://ethereum-sepolia-rpc.publicnode.com

# Optional scoreboard (Ganache local; Anvil also supported)
SCOREBOARD_RPC_URL=http://127.0.0.1:7545
SCOREBOARD_CHAIN_ID=1337
SCOREBOARD_CHAIN_NAME="Ganache local"
# Use a random SECRET_KEY instead of supersecretkey to enable signed results.
SCOREBOARD_ADDRESS=
# Dedicated server signing key, never the player's wallet key.
SCOREBOARD_SIGNER_KEY=

# Optional public testnet scoreboard (Alchemy / Ethereum Sepolia).
# Set these only in your private .env. Do not commit actual API/private keys.
# Deploy with: python scripts/deploy_scoreboard.py --network sepolia
# Preview first; add --broadcast to send the deployment with test ETH.
SCOREBOARD_SEPOLIA_RPC_URL=
# Example: https://eth-sepolia.g.alchemy.com/v2/YOUR_API_KEY
SCOREBOARD_DEPLOYER_KEY=
# Use a dedicated Sepolia test account, different from SCOREBOARD_SIGNER_KEY.
# The wallet receives a public Sepolia RPC; the Alchemy URL stays on the server.
